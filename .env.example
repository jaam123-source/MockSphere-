# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Live Email Delivery (Gmail SMTP or custom SMTP)
# To send real emails from Contact Us and Candidate Registration on live hosting (e.g. Vercel):
# 1. GMAIL_USER: Your Gmail address (e.g., supportmocksphere@gmail.com)
# 2. GMAIL_APP_PASSWORD: 16-character Google App Password (from https://myaccount.google.com/apppasswords)
# 3. CONTACT_RECEIVER_EMAIL: The inbox where contact inquiries should be delivered (e.g., support@mock-sphere.com)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
CONTACT_RECEIVER_EMAIL="support@mock-sphere.com"

# Custom SMTP Relay Configuration (Alternative to Gmail)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mock Sphere <support@mock-sphere.com>"

# Google OAuth 2.0 Credentials (for Vercel production deployment)
# Configure these in Vercel Project Settings -> Environment Variables
# In Google Cloud Console: Add your Vercel domains (e.g. https://your-app.vercel.app) to Authorized JavaScript Origins
# and https://your-app.vercel.app/api/auth/callback/google to Authorized Redirect URIs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Firebase Cloud Firestore Configuration (Production overrides for Vercel)
# If not set, the applet automatically reads from bundled firebase-applet-config.json
FIREBASE_PROJECT_ID="gen-lang-client-0470119433"
FIREBASE_DATABASE_ID="ai-studio-aipoweredmultimo-46ffba00-101d-408d-a748-1345aad4f9b6"
FIREBASE_API_KEY="AIzaSyC1XqayCbqNmjvuanPOY-kmFaSNqozPrxs"
FIREBASE_AUTH_DOMAIN="gen-lang-client-0470119433.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="gen-lang-client-0470119433.firebasestorage.app"
FIREBASE_APP_ID="1:502487763181:web:526af4f05a90bb1bb524e4"

# Client-side Vite Firebase overrides (optional, bundled by default)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_PROJECT_ID=""

