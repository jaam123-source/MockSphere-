rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - reject everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jaammaaj123@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('jaammaaj123@gmail\\.com'))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users collection: user profiles
    match /users/{userId} {
      allow get, create, update, delete: if isValidId(userId);
      allow list: if true;
    }

    // User Progress collection: user-isolated aptitude levels, attempts, technical & HR interview results
    match /user_progress/{userId} {
      allow get, create, update, delete: if isValidId(userId);
      allow list: if true;
    }

    // Technical Domain Progress collection: user-isolated question-wise resume tracking per domain
    match /technical_domain_progress/{docId} {
      allow get, create, update, delete: if isValidId(docId);
      allow list: if true;
    }

    // Global settings: readable and writable
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Aptitude and interview question banks: readable by all
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
