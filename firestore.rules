rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - reject everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jaammaaj123@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('jaammaaj123@gmail\\.com'))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users collection: candidates can read & modify their own profile; admin can view all
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // User Progress collection: user-isolated aptitude levels, attempts, technical & HR interview results
    match /user_progress/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Global settings: readable by application clients, writable exclusively by administrator
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Aptitude and interview question banks: readable by authenticated / active candidates, managed by admin
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
